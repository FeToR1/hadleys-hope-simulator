// Programs of the settlement when the world computes the physics.
// The house decides the heating, the appliances ask for power, the resident lives a day, the crew repairs
// what breaks, marines hunt, and the xenomorph breaks through the fence to the grid and the people.
// Nothing here touches the physical state directly.

event HeatingDemand { enabled: Bool; }
event PowerLost {}
event PowerRestored {}
event WaterLost {}
event ObjectBroken { object: String; reason: String; }
event RepairCompleted { object: String; }
event ArrivalConfirmed { point: Position; }
event VehicleTransportRequest { destination: Position; }

behavior HouseControl for House {
    param heater: Ref<Heater>;
    state demand: Bool = false;
    state sent: Option<Bool> = none;
    state dark: Bool = false;
    state dry: Bool = false;

    on PowerLost(m) as lights_out { dark = true; }
    on PowerRestored(m) as lights_on { dark = false; }
    on WaterLost(m) as no_water { dry = true; }

    every 1s as regulate {
        // Hysteresis: heat below 18 degrees, stop above 21, and never heat an empty house.
        if view.occupants == 0 {
            demand = false;
        } else if view.temperature < 18degC {
            demand = true;
        } else if view.temperature >= 21degC {
            demand = false;
        }
        if sent != some(demand) {
            send HeatingDemand { enabled: demand } to heater;
            sent = some(demand);
        }
    }
}

behavior HeaterControl for Heater {
    param rating: Power;
    state demand: Bool = false;

    on HeatingDemand(message) as remember { demand = message.enabled; }

    every 1s as apply {
        if view.home_occupants == 0 || view.broken || !view.power_connected {
            power.request(0W);
        } else if demand {
            power.request(rating);
        } else {
            power.request(0W);
        }
    }
}

behavior KettleControl for Kettle {
    state boiling: Bool = false;

    every 1s as heat {
        // Someone puts the kettle on when they are home and it has cooled down.
        if view.home_occupants == 0 || view.broken || !view.power_connected {
            boiling = false;
            power.request(0W);
        } else {
            if view.water_temperature < 30degC { boiling = true; }
            if view.water_temperature >= 95degC { boiling = false; }
            if boiling { power.request(2kW); } else { power.request(0W); }
        }
    }
}

behavior Resident for Human {
    enum Mood { Calm, Agitated }
    enum DamageCause { Vandalism }
    enum Occupation { Miner, ColonyWorker, HomeResident }
    enum Activity { Resting, GoingToWork, Mining, Working, GoingToMeet, Socializing, ReturningHome, Injured, Dead }

    state mood: Mood = Calm;
    state occupation: Occupation = HomeResident;
    state activity: Activity = Resting;
    state stress: Real64 = 0.15;
    state minute: Int64 = 0;
    state shift_start: Int64 = 0;
    state shift_end: Int64 = 0;
    state next_attempt: Duration = 0s;

    on PowerLost(m) as react_to_outage { stress = clamp(stress + 0.12, 0.0, 1.0); }
    on WaterLost(m) as react_to_water { stress = clamp(stress + 0.08, 0.0, 1.0); }

    every 1s as routine {
        // Stable cohorts: two mine shifts, local services, and residents without a work shift.
        // Small departure offsets stop a whole shift leaving on the same tick.
        minute = view.day_minute;
        let cohort = view.routine_slot % 4;
        let offset = (view.routine_slot % 3) * 5;
        if cohort == 0 {
            occupation = Miner;
            shift_start = 480 + offset;
            shift_end = 840 + offset;
        } else if cohort == 3 {
            occupation = Miner;
            shift_start = 840 + offset;
            shift_end = 1200 + offset;
        } else if cohort == 2 {
            occupation = ColonyWorker;
            shift_start = 540 + offset;
            shift_end = 1020 + offset;
        } else {
            occupation = HomeResident;
            shift_start = 0;
            shift_end = 0;
        }

        // Injured residents stay home. On the way to work a resident takes a rover when the world offers one:
        // it stands at its depot within walking distance and still has a seat for them. A transport request is
        // sent only within the rover's boarding radius, so the world remains responsible for boarding.
        if view.health <= 0hp {
            activity = Dead;
        } else if view.in_vehicle {
            if minute >= shift_start && minute < shift_end { activity = GoingToWork; }
            else { activity = ReturningHome; }
        } else if view.medical_required {
            if view.position == view.workplace {
                activity = Injured;
            } else if let vehicle = nearest(view.available_vehicles) {
                if vehicle.distance <= view.boarding_radius {
                    send VehicleTransportRequest { destination: view.workplace } to vehicle.id;
                    activity = Injured;
                } else {
                    activity = Injured;
                    motion.request(vehicle.position, 1.4mps);
                }
            } else {
                activity = Injured;
                motion.request(view.workplace, 1.4mps);
            }
        } else if view.health < 40hp {
            activity = Injured;
            if view.position != view.home { motion.request(view.home, 1.4mps); }
        } else if minute >= shift_start && minute < shift_end {
            if view.position == view.workplace {
                if occupation == Miner { activity = Mining; } else { activity = Working; }
            } else {
                if let vehicle = nearest(view.available_vehicles) {
                    if vehicle.distance <= view.boarding_radius {
                        send VehicleTransportRequest { destination: view.workplace } to vehicle.id;
                        activity = GoingToWork;
                    } else {
                        activity = GoingToWork;
                        motion.request(vehicle.position, 1.4mps);
                    }
                } else {
                    activity = GoingToWork;
                    motion.request(view.workplace, 1.4mps);
                }
            }
        } else if (occupation == HomeResident && minute >= 660 + offset && minute < 720 + offset)
            || (occupation != HomeResident && minute >= shift_end + 60 && minute < shift_end + 105) {
            if view.position == view.meeting_point {
                activity = Socializing;
            } else {
                activity = GoingToMeet;
                motion.request(view.meeting_point, 1.2mps);
            }
        } else if view.position != view.home {
            activity = ReturningHome;
            motion.request(view.home, 1.4mps);
        } else {
            activity = Resting;
        }
    }

    every 1min as live {
        if view.cold {
            stress = clamp(stress + 0.05, 0.0, 1.0);
        } else if activity == Socializing || activity == Resting {
            stress = clamp(stress - 0.05, 0.0, 1.0);
        } else {
            stress = clamp(stress - 0.03, 0.0, 1.0);
        }
        if stress > 0.8 { mood = Agitated; } else if stress < 0.35 { mood = Calm; }

        if mood == Agitated && time >= next_attempt {
            if let target = nearest(view.reachable_breakables) {
                if chance(0.12, "vandalism") {
                    damage.request(target.id, 25hp, Vandalism);
                    next_attempt = time + 20min;
                }
            }
        }
    }
}

behavior RepairCrew for Rover {
    enum Mode { Idle, Driving, Working }
    state mode: Mode = Idle;
    state repaired: Int64 = 0;

    on RepairCompleted(m) as finished { repaired = repaired + 1; }

    every 1s as work {
        // Passenger transport has priority, including residents still walking to their seats. The kernel accepts
        // boarding requests and exposes the resulting route and readiness; the rover only decides whether to move.
        if view.passenger_count > 0 || view.boarding_pending > 0 {
            if view.transport_ready {
                mode = Driving;
                motion.request(view.transport_target, view.speed_eff);
            } else {
                mode = Idle;
            }
        } else if let job = nearest(view.active_jobs) {
            if job.distance > view.work_radius {
                mode = Driving;
                motion.request(job.position, view.speed_eff);
            } else {
                mode = Working;
                repair.request(job.object);
            }
        } else {
            mode = Idle;
            motion.request(view.depot, view.speed_eff);
        }
    }
}

// Keep part of a large colony's fleet available even while repair crews have a backlog.
behavior PassengerRover for Rover {
    enum Mode { Idle, Boarding, Driving }
    state mode: Mode = Idle;

    every 1s as transport {
        if view.passenger_count > 0 || view.boarding_pending > 0 {
            if view.transport_ready {
                mode = Driving;
                motion.request(view.transport_target, view.speed_eff);
            } else {
                mode = Boarding;
            }
        } else {
            mode = Idle;
            motion.request(view.depot, view.speed_eff);
        }
    }
}

// Dedicated services follow the kernel's currently assigned physical work point.
behavior CleanupRover for Rover {
    every 1s as cleanup {
        motion.request(view.depot, view.speed_eff);
    }
}

behavior Forester for Rover {
    every 1s as forestry {
        motion.request(view.depot, view.speed_eff);
    }
}

// Resource transport is a separate role. The kernel reserves these units for the mine/depository/medical route.
behavior CargoRover for Rover {
    every 1s as logistics {
        if view.passenger_count == 0 && view.boarding_pending == 0 {
            motion.request(view.depot, view.speed_eff);
        }
    }
}

behavior MarineSquad for Marine {
    enum Activity { Guard, Rearming, GoingToVehicle, WaitingForSquad, Transporting, Engaging, ReturningHome, Dead }
    enum DamageCause { MarineAssault }
    param squad: String;
    param leader: Bool;
    param success_probability: Probability;

    state activity: Activity = Guard;
    state attempted: Bool = false;
    state ready_at: Duration = 0s;

    every 1s as mission {
        // The squads go after xenomorphs inside the fence. Gathering at one drives it off; the leader may also
        // kill it. One assault per sortie: the squad then walks back to base, rearms and is ready again.
        // With nothing to go after, a squad walks back to base instead of standing where it was left.
        if view.health <= 0hp {
            activity = Dead;
        } else if attempted {
            if view.position == view.depot {
                attempted = false;
                activity = Rearming;
                ready_at = time + 2min;
            } else {
                activity = ReturningHome;
                if !view.in_vehicle { motion.request(view.depot, 1.5mps); }
            }
        } else if !view.dispatch_ready || time < ready_at {
            if activity != Rearming { activity = Guard; }
        } else if let target = nearest(view.visible_predators) {
            if view.squad_ready {
                activity = Engaging;
                if view.squad_leader && chance(success_probability, "marine_assault") {
                    damage.request(target.id, 100hp, MarineAssault);
                }
                attempted = true;
            } else if view.in_vehicle {
                activity = Transporting;
            } else if activity == Transporting || activity == Engaging {
                activity = Engaging;
                motion.request(target.position, 1.5mps);
            } else if let vehicle = nearest(view.available_vehicles) {
                if vehicle.distance > view.boarding_radius {
                    activity = GoingToVehicle;
                    motion.request(vehicle.position, 1.5mps);
                } else {
                    activity = GoingToVehicle;
                    send VehicleTransportRequest { destination: target.position } to vehicle.id;
                }
            } else {
                activity = WaitingForSquad;
            }
        } else if let target = nearest(view.visible_xenomorphs) {
            if view.squad_ready {
                activity = Engaging;
                if view.squad_leader && chance(success_probability, "marine_assault") {
                    damage.request(target.id, 100hp, MarineAssault);
                }
                attempted = true;
            } else if view.in_vehicle {
                activity = Transporting;
            } else if activity == Transporting || activity == Engaging {
                activity = Engaging;
                motion.request(target.position, 1.5mps);
            } else if let vehicle = nearest(view.available_vehicles) {
                if vehicle.distance > view.boarding_radius {
                    activity = GoingToVehicle;
                    motion.request(vehicle.position, 1.5mps);
                } else {
                    activity = GoingToVehicle;
                    send VehicleTransportRequest { destination: target.position } to vehicle.id;
                }
            } else {
                activity = WaitingForSquad;
            }
        } else {
            activity = Guard;
            if view.position != view.depot && !view.in_vehicle { motion.request(view.depot, 1.5mps); }
        }
    }
}

behavior Xenomorph for Xenomorph {
    enum Mode { Patrol, Chase, Hunt, Attack, Bite, Flee }
    enum DamageCause { XenomorphAttack }
    state mode: Mode = Patrol;
    state sated_until: Duration = 0s;

    every 1s as decide {
        mode = Patrol;
        if view.routed {
            // Marines drove it off: it runs for the wilds through a breach, or breaks the fence in its way.
            mode = Flee;
            if let near = nearest(view.visible_infrastructure) {
                if near.kind == "Fence" && near.distance <= 3m {
                    if hazard(0.5per_s, "strike") {
                        damage.request(near.id, 40hp, XenomorphAttack);
                    }
                } else {
                    motion.request(view.patrol_waypoint, 6mps);
                }
            } else {
                motion.request(view.patrol_waypoint, 6mps);
            }
        } else if !view.attack_active {
            mode = Patrol;
            motion.request(view.patrol_waypoint, 3mps);
        } else {
            // What is within reach comes first: the fence segment it ran into or a pole next to it. Then people
            // in the open, then the grid, then the next point of its round. A closed fence stops it until broken.
            // After a bite the hunter leaves people alone for a while, so the bitten one can get home.
            let hungry = time >= sated_until;
            if let near = nearest(view.visible_infrastructure) {
                if near.distance <= 3m {
                    mode = Attack;
                    if hazard(0.5per_s, "strike") {
                        damage.request(near.id, 40hp, XenomorphAttack);
                    }
                }
            }
            if mode == Patrol && hungry {
                if let prey = nearest(view.visible_humans) {
                    if prey.distance > 2m {
                        mode = Hunt;
                        motion.request(prey.position, 6mps);
                    } else {
                        mode = Bite;
                        if hazard(0.5per_s, "bite") {
                            damage.request(prey.id, 35hp, XenomorphAttack);
                            sated_until = time + 5min;
                        }
                    }
                }
            }
            if mode == Patrol {
                if let target = nearest(view.visible_infrastructure) {
                    mode = Chase;
                    motion.request(target.position, 6mps);
                } else {
                    motion.request(view.patrol_waypoint, 3mps);
                }
            }
        }
    }
}

// Klyaksa's indigenous predator reuses the ground-hunter tactics while retaining a distinct entity kind and cause.
behavior GroundPredator for Predator {
    enum Mode { Patrol, Chase, Hunt, Attack, Bite, Flee }
    enum DamageCause { PredatorAttack }
    state mode: Mode = Patrol;
    state sated_until: Duration = 0s;

    every 1s as decide {
        mode = Patrol;
        if view.routed {
            mode = Flee;
            if let near = nearest(view.visible_infrastructure) {
                if near.kind == "Fence" && near.distance <= 3m {
                    if hazard(0.5per_s, "strike") { damage.request(near.id, 40hp, PredatorAttack); }
                } else { motion.request(view.patrol_waypoint, 6mps); }
            } else { motion.request(view.patrol_waypoint, 6mps); }
        } else if !view.attack_active {
            motion.request(view.patrol_waypoint, 3mps);
        } else {
            let hungry = time >= sated_until;
            if let near = nearest(view.visible_infrastructure) {
                if near.distance <= 3m {
                    mode = Attack;
                    if hazard(0.5per_s, "strike") { damage.request(near.id, 40hp, PredatorAttack); }
                }
            }
            if mode == Patrol && hungry {
                if let prey = nearest(view.visible_humans) {
                    if prey.distance > 2m {
                        mode = Hunt;
                        motion.request(prey.position, 6mps);
                    } else {
                        mode = Bite;
                        if hazard(0.5per_s, "bite") {
                            damage.request(prey.id, 35hp, PredatorAttack);
                            sated_until = time + 5min;
                        }
                    }
                }
            }
            if mode == Patrol {
                if let target = nearest(view.visible_infrastructure) {
                    mode = Chase;
                    motion.request(target.position, 6mps);
                } else { motion.request(view.patrol_waypoint, 3mps); }
            }
        }
    }
}
