// Programs of the settlement when the world computes the physics.
// The house decides the heating, the appliances ask for power, the resident lives a day, the crew repairs
// what breaks, and the xenomorph attacks the grid. Nothing here touches the physical state directly.

event HeatingDemand { enabled: Bool; }
event PowerLost {}
event PowerRestored {}
event WaterLost {}
event ObjectBroken { object: String; reason: String; }
event RepairCompleted { object: String; }
event ArrivalConfirmed { point: Position; }
event VehicleTransportRequest { destination: Position; }

behavior HouseControl for House {
    param heater: Ref<Heater>;
    state demand: Bool = false;
    state sent: Option<Bool> = none;
    state dark: Bool = false;
    state dry: Bool = false;

    on PowerLost(m) as lights_out { dark = true; }
    on PowerRestored(m) as lights_on { dark = false; }
    on WaterLost(m) as no_water { dry = true; }

    every 1s as regulate {
        // Hysteresis: heat below 18 degrees, stop above 21, and never heat an empty house.
        if view.occupants == 0 {
            demand = false;
        } else if view.temperature < 18degC {
            demand = true;
        } else if view.temperature >= 21degC {
            demand = false;
        }
        if sent != some(demand) {
            send HeatingDemand { enabled: demand } to heater;
            sent = some(demand);
        }
    }
}

behavior HeaterControl for Heater {
    param rating: Power;
    state demand: Bool = false;

    on HeatingDemand(message) as remember { demand = message.enabled; }

    every 1s as apply {
        if view.home_occupants == 0 || view.broken || !view.power_connected {
            power.request(0W);
        } else if demand {
            power.request(rating);
        } else {
            power.request(0W);
        }
    }
}

behavior KettleControl for Kettle {
    state boiling: Bool = false;

    every 1s as heat {
        // Someone puts the kettle on when they are home and it has cooled down.
        if view.home_occupants == 0 || view.broken || !view.power_connected {
            boiling = false;
            power.request(0W);
        } else {
            if view.water_temperature < 30degC { boiling = true; }
            if view.water_temperature >= 95degC { boiling = false; }
            if boiling { power.request(2kW); } else { power.request(0W); }
        }
    }
}

behavior Resident for Human {
    enum Mood { Calm, Agitated }
    enum DamageCause { Vandalism }
    enum Occupation { Miner, ColonyWorker, HomeResident }
    enum Activity { Resting, GoingToWork, Mining, Working, GoingToMeet, Socializing, ReturningHome, Injured, Dead }

    state mood: Mood = Calm;
    state occupation: Occupation = HomeResident;
    state activity: Activity = Resting;
    state stress: Real64 = 0.15;
    state minute: Int64 = 0;
    state shift_start: Int64 = 0;
    state shift_end: Int64 = 0;
    state next_attempt: Duration = 0s;

    on PowerLost(m) as react_to_outage { stress = clamp(stress + 0.12, 0.0, 1.0); }
    on WaterLost(m) as react_to_water { stress = clamp(stress + 0.08, 0.0, 1.0); }

    every 1s as routine {
        // Stable cohorts: two mine shifts, local services, and residents without a work shift.
        // Small departure offsets stop a whole shift leaving on the same tick.
        minute = view.day_minute;
        let cohort = view.routine_slot % 4;
        let offset = (view.routine_slot % 3) * 5;
        if cohort == 0 {
            occupation = Miner;
            shift_start = 480 + offset;
            shift_end = 840 + offset;
        } else if cohort == 3 {
            occupation = Miner;
            shift_start = 840 + offset;
            shift_end = 1200 + offset;
        } else if cohort == 2 {
            occupation = ColonyWorker;
            shift_start = 540 + offset;
            shift_end = 1020 + offset;
        } else {
            occupation = HomeResident;
            shift_start = 0;
            shift_end = 0;
        }

        // Injured residents stay home. A subset of working residents uses the rover fleet when one is nearby;
        // everyone else keeps the existing walking behavior. A transport request is deliberately sent only when
        // the resident has reached the rover's boarding radius, so the world remains responsible for boarding.
        if view.health <= 0hp {
            activity = Dead;
        } else if view.health < 40hp {
            activity = Injured;
            if view.position != view.home && !view.in_vehicle { motion.request(view.home, 1.4mps); }
        } else if minute >= shift_start && minute < shift_end {
            if view.position == view.workplace {
                if occupation == Miner { activity = Mining; } else { activity = Working; }
            } else if view.in_vehicle {
                activity = GoingToWork;
            } else if view.routine_slot % 5 == 0 {
                if let vehicle = nearest(view.available_vehicles) {
                    if vehicle.distance <= 6m {
                        send VehicleTransportRequest { destination: view.workplace } to vehicle.id;
                        activity = GoingToWork;
                    } else {
                        activity = GoingToWork;
                        motion.request(vehicle.position, 1.4mps);
                    }
                } else {
                    activity = GoingToWork;
                    motion.request(view.workplace, 1.4mps);
                }
            } else {
                activity = GoingToWork;
                motion.request(view.workplace, 1.4mps);
            }
        } else if (occupation == HomeResident && minute >= 660 + offset && minute < 720 + offset)
            || (occupation != HomeResident && minute >= shift_end + 60 && minute < shift_end + 105) {
            if view.position == view.meeting_point {
                activity = Socializing;
            } else {
                activity = GoingToMeet;
                motion.request(view.meeting_point, 1.2mps);
            }
        } else if view.position != view.home {
            if view.in_vehicle {
                activity = ReturningHome;
            } else if view.routine_slot % 5 == 0 {
                if let vehicle = nearest(view.available_vehicles) {
                    if vehicle.distance <= 6m {
                        send VehicleTransportRequest { destination: view.home } to vehicle.id;
                        activity = ReturningHome;
                    } else {
                        activity = ReturningHome;
                        motion.request(vehicle.position, 1.4mps);
                    }
                } else {
                    activity = ReturningHome;
                    motion.request(view.home, 1.4mps);
                }
            } else {
                activity = ReturningHome;
                motion.request(view.home, 1.4mps);
            }
        } else {
            activity = Resting;
        }
    }

    every 1min as live {
        if view.cold {
            stress = clamp(stress + 0.05, 0.0, 1.0);
        } else if activity == Socializing || activity == Resting {
            stress = clamp(stress - 0.05, 0.0, 1.0);
        } else {
            stress = clamp(stress - 0.03, 0.0, 1.0);
        }
        if stress > 0.8 { mood = Agitated; } else if stress < 0.35 { mood = Calm; }

        if mood == Agitated && time >= next_attempt {
            if let target = nearest(view.reachable_breakables) {
                if chance(0.12, "vandalism") {
                    damage.request(target.id, 25hp, Vandalism);
                    next_attempt = time + 20min;
                }
            }
        }
    }
}

behavior RepairCrew for Rover {
    enum Mode { Idle, Driving, Working }
    state mode: Mode = Idle;
    state repaired: Int64 = 0;

    on RepairCompleted(m) as finished { repaired = repaired + 1; }

    every 1s as work {
        // Passenger transport has priority. The kernel accepts boarding requests and exposes the resulting
        // route and readiness; the rover itself only decides whether to move there.
        if view.passenger_count > 0 {
            if view.transport_ready {
                mode = Driving;
                motion.request(view.transport_target, view.speed_eff);
            } else {
                mode = Idle;
            }
        } else if let job = nearest(view.active_jobs) {
            if job.distance > 5m {
                mode = Driving;
                motion.request(job.position, view.speed_eff);
            } else {
                mode = Working;
                repair.request(job.object);
            }
        } else {
            mode = Idle;
            motion.request(view.depot, view.speed_eff);
        }
    }
}

behavior MarineSquad for Marine {
    enum Activity { Guard, GoingToVehicle, WaitingForSquad, Transporting, Engaging, ReturningHome, Dead }
    enum DamageCause { MarineAssault }
    param squad: String;
    param leader: Bool;
    param success_probability: Probability;

    state activity: Activity = Guard;
    state attempted: Bool = false;

    every 1s as mission {
        if view.health <= 0hp {
            activity = Dead;
        } else if attempted {
            activity = ReturningHome;
            if view.position != view.depot && !view.in_vehicle {
                motion.request(view.depot, 1.5mps);
            }
        } else if !view.dispatch_ready {
            activity = Guard;
        } else if let target = nearest(view.visible_xenomorphs) {
            if view.squad_ready {
                activity = Engaging;
                if view.squad_leader && chance(success_probability, "marine_assault") {
                    damage.request(target.id, 100hp, MarineAssault);
                }
                attempted = true;
            } else if view.in_vehicle {
                activity = Transporting;
            } else if let vehicle = nearest(view.available_vehicles) {
                if vehicle.distance > 6m {
                    activity = GoingToVehicle;
                    motion.request(vehicle.position, 1.5mps);
                } else {
                    activity = GoingToVehicle;
                    send VehicleTransportRequest { destination: target.position } to vehicle.id;
                }
            } else {
                activity = WaitingForSquad;
            }
        } else {
            activity = Guard;
        }
    }
}

behavior Xenomorph for Xenomorph {
    enum Mode { Patrol, Chase, Attack }
    enum DamageCause { XenomorphAttack }
    state mode: Mode = Patrol;

    every 1s as decide {
        if let target = nearest(view.visible_infrastructure) {
            if target.distance > 3m {
                mode = Chase;
                motion.request(target.position, 6mps);
            } else {
                mode = Attack;
                if hazard(0.5per_s, "strike") {
                    damage.request(target.id, 40hp, XenomorphAttack);
                }
            }
        } else {
            mode = Patrol;
            motion.request(view.patrol_waypoint, 3mps);
        }
    }
}
