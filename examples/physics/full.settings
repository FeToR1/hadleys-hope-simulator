                fuelPerUnit = 0.04;
                fuelPerMetre = 0.1;
                initialDepotFuel = 0.0;
                depotFuelCapacity = 100000.0;
                fuelRestockPerSecond = 0.0;
            }
            plankton {
                enabled = false;
                coastalWidth = 120.0m;
                wavePeriodSeconds = 3600.0s;
                initialBiomassPerCoastalZone = 500.0;
                regrowthPerSecond = 0.05;
                damagePerSecond = 0.04;
                burningPerSecond = 5.0;
                burnFuelPerBiomass = 0.2;
                burnPowerPerSecond = 4000.0W;
                initialBurnFuel = 10000.0;
                fuelCostPerUnit = 3;
                fuelCapacity = 10000.0;
                fuelRestockPerSecond = 0.0;
                burnerCount = 1;
                burnerSpacing = 140.0;
            }
            humanFactors {
                enabled = false;
                availabilityCycleSeconds = 1800.0s;
                unavailableSeconds = 120.0s;
                boredomSeconds = 180.0s;
                vandalPeriodSeconds = 2400.0s;
                vandalDamage = 5.0hp;
                vandalChancePercent = 8;
                vandalRadius = 12.0m;
                alcoholPeriodSeconds = 3600.0s;
                alcoholDurationSeconds = 180.0s;
            }
            crocodileManurePerSecond = 0.15;
        }
        geometry {
            coastX = none;
            mine = none;
            depository = none;
            medicalCenter = none;
            gates = [];
            gateWidth = 12.0m;
        }
    }
}
