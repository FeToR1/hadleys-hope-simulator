{
  "name": "Colony",
  "scopeName": "source.colony",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "name": "keyword.control.colony",
      "match": "\\b(?:settings|source|include|at|template|object|using|population|behavior|for|event|enum|param|state|on|every|as|let|if|else|send|to)\\b"
    },
    {
      "name": "constant.language.colony",
      "match": "\\b(?:true|false|none|self)\\b"
    },
    {
      "name": "support.type.colony",
      "match": "\\b(?:Bool|Int64|Real64|String|Duration|Probability|Rate|Money|Temperature|Power|Energy|Volume|Distance|Speed|Health|Ref|Option|List)\\b"
    },
    {
      "name": "constant.numeric.colony",
      "match": "(?<![\\w.])(?:[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?(?:[a-zA-Z_µ][a-zA-Z0-9_µ]*)?|\\.[0-9]+(?:[eE][+-]?[0-9]+)?)(?![\\w])"
    },
    {
      "name": "support.variable.colony",
      "match": "\\b(?:view|time|power|damage|motion|repair)\\b"
    },
    {
      "name": "support.function.colony",
      "match": "\\b(?:nearest|chance|hazard|some|random|request)\\b(?=\\s*\\()"
    },
    {
      "name": "entity.name.function.colony",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "entity.name.type.colony",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "keyword.operator.colony",
      "match": "==|!=|<=|>=|&&|\\|\\||[=<>!+*/%\\-]"
    },
    {
      "name": "punctuation.section.colony",
      "match": "[{}\\[\\]()]"
    },
    {
      "name": "punctuation.separator.colony",
      "match": "[.,:;]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.colony",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.colony",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.colony",
      "begin": "\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "name": "constant.character.escape.colony",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        },
        {
          "name": "invalid.illegal.escape.colony",
          "match": "\\\\."
        }
      ]
    }
  }
}
